{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/event.html", "destination": "/", "permanent": false },
    { "source": "/company.html", "destination": "/", "permanent": false },
    { "source": "/form.html", "destination": "/", "permanent": false },
    { "source": "/checkin.html", "destination": "/", "permanent": false },
    { "source": "/forms/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/events/:slug", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://wfkohcwxxsrhcxhepfql.supabase.co; img-src 'self' data: https://dzlmtvodpyhetvektfuo.supabase.co; media-src 'self' https://dzlmtvodpyhetvektfuo.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}